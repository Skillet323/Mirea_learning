digraph labirint {
    node [shape=box, fontsize=10];
    "1" [label="Комната  №1\nВы стоите у высоких, древних ворот, ведущих в лабиринт, чьи стены уходят в туман, скрывая его тайны. Воздух здесь прохладный, и где-то вдалеке слышится эхо капающей воды. Сможете ли вы найти выход?"];
    "1" -> "2" [label="Проход на запад"];
    "2" [label="Комната  №2\nВы находитесь в узкой, извилистой комнате, где стены украшены древними рунами, светящимися при слабом свете. Кажется, что каждая руна несёт своё сообщение."];
    "2" -> "3" [label="Проход на запад"];
    "2" -> "1" [label="Проход на восток"];
    "3" [label="Комната  №3\nЭта комната напоминает подземное озеро. Вода мерцает зелёным светом, отражая странные формы на стенах. В центре комнаты стоит древний каменный алтарь."];
    "3" -> "4" [label="Проход на север"];
    "3" -> "2" [label="Проход на восток"];
    "4" [label="Комната  №4\nВы оказались в огромной зале, поддерживаемой колоннами из чёрного камня. В центре залы горит вечный огонь, освещая древние фрески на стенах."];
    "4" -> "5" [label="Проход на север"];
    "4" -> "3" [label="Проход на юг"];
    "5" [label="Комната  №5\nЭта комната наполнена странными звуками, похожими на шёпот ветра. На стенах висят старинные ковры, изображающие сцены из легенд."];
    "5" -> "4" [label="Проход на юг"];
    "5" -> "6" [label="Проход на восток"];
    "6" [label="Комната  №6\nВы находитесь в комнате, где воздух наполнен запахом мёда и лаванды. На стенах развешаны зеркала, искажающие ваше отражение."];
    "6" -> "15" [label="Проход на север"];
    "6" -> "7" [label="Проход на юг"];
    "6" -> "5" [label="Проход на запад"];
    "6" -> "11" [label="Проход на восток"];
    "7" [label="Комната  №7\nЭта комната напоминает древний библиотекарский зал. Полки, уходящие вверх, полны старинных книг и свитков."];
    "7" -> "6" [label="Проход на север"];
    "7" -> "8" [label="Проход на восток"];
    "8" [label="Комната  №8\nВы находитесь в комнате, напоминающей тронный зал. В центре стоит пустой трон, окружённый статуями древних стражей."];
    "8" -> "7" [label="Проход на запад"];
    "8" -> "9" [label="Проход на восток"];
    "9" [label="Комната  №9\nЭта комната полна звуков падающей воды. В центре находится водопад, падающий в подземное озеро, его брызги создают радугу в воздухе."];
    "9" -> "10" [label="Проход на юг"];
    "9" -> "8" [label="Проход на запад"];
    "10" [label="Комната  №10\nВы находитесь в пещере, где воздух насыщен влагой. На стенах видны следы древних наскальных рисунков."];
    "10" -> "9" [label="Проход на север"];
    "11" [label="Комната  №11\nЭта комната напоминает сад, выращенный в подземелии. Растения здесь светятся мягким светом, создавая атмосферу спокойствия."];
    "11" -> "6" [label="Проход на запад"];
    "11" -> "12" [label="Проход на восток"];
    "12" [label="Комната  №12\nВы находитесь в комнате, где стены украшены мозаиками, изображающими сцены из древних легенд. В центре стоит фонтан, из которого течёт кристально чистая вода."];
    "12" -> "13" [label="Проход на север"];
    "12" -> "11" [label="Проход на запад"];
    "13" [label="Комната  №13\nЭта комната напоминает древний храм. В центре стоит монолит, на котором высечены странные символы. Воздух здесь наэлектризован."];
    "13" -> "12" [label="Проход на юг"];
    "13" -> "14" [label="Проход на запад"];
    "14" [label="Комната  №14\nВы находитесь в комнате, где стены покрыты мхом, а воздух наполнен запахом земли. В центре комнаты растёт древнее дерево, корни которого уходят глубоко вниз."];
    "14" -> "13" [label="Проход на восток"];
    "15" [label="Комната  №15\nВы находитесь в комнате, наполненной светом, исходящим из кристаллов на стенах. В центре стоит портал, светящийся ярким белым светом."];
    "15" -> "6" [label="Проход на юг"];
    "15" -> "16" [label="Проход на запад"];
    "16" [label="Комната  №16\nВы находитесь в комнате, где стены покрыты кристаллами, издающими мелодичные звуки при прикосновении. В центре комнаты стоит каменная плита, на которой высечена карта лабиринта."];
    "16" -> "15" [label="Проход на восток"];
}