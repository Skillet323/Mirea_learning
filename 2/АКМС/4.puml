@startuml
skinparam classAttributeIconSize 0

state Консультация {
    [*] --> Включена : Пользователь запустил консультацию

    state Включена {
        Включена: entry / Инициализация системы
        Включена: do / Отображение интерфейса
        Включена: exit / Запрос симптомов
    }

    state Сбор_данных {
        Сбор_данных: entry / Активация формы ввода
        Сбор_данных: do / Прием информации от пользователя
        Сбор_данных: exit / Валидация данных
    }

    state В_обработке {
        В_обработке: entry / Запуск NLP-анализа
        В_обработке: do / Обработка данных
        В_обработке: exit / Генерация рекомендаций
    }

    state Анализ_завершен {
        Анализ_завершен: entry / Проверка результатов
        Анализ_завершен: do / Формирование вывода
        Анализ_завершен: exit / Подготовка ответа
    }

    state Рекомендации_готовы {
        Рекомендации_готовы: entry / Отображение препаратов
        Рекомендации_готовы: do / Ожидание завершения
        Рекомендации_готовы: exit / Завершение консультации
    }

    state Ошибка_обработки {
        Ошибка_обработки: entry / Логирование ошибки
        Ошибка_обработки: do / Отображение сообщения
        Ошибка_обработки: exit / Очистка данных
    }

    state Прервана {
        Прервана: entry / Сохранение прогресса
        Прервана: do / Отправка уведомления
        Прервана: exit / Завершение процесса
    }

    Включена --> Сбор_данных : Система запросила симптомы
    Сбор_данных --> В_обработке : Пользователь завершил ввод
    В_обработке --> Анализ_завершен : NLP-анализ завершен
    Анализ_завершен --> Рекомендации_готовы : Препараты подобраны
    Анализ_завершен --> Ошибка_обработки : [Недостаточно данных]
    Рекомендации_готовы --> [*] : Консультация завершена
    Ошибка_обработки --> [*] : Ошибка
    Включена --> Прервана : Пользователь отменил/Таймаут
    Сбор_данных --> Прервана : Пользователь отменил/Таймаут
    В_обработке --> Прервана : Пользователь отменил/Таймаут
    Прервана --> [*] : Прервана
}
@enduml